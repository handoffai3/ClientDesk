# Site — canonical URL of the deployed app (used in emails, auth redirects, Stripe callbacks)
PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase — project URL and anon key (public, embedded in the client bundle)
PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (server-only, bypasses RLS — never expose with PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — secret key for server-side API calls
STRIPE_SECRET_KEY=sk_test_...

# Stripe — publishable key for client-side Checkout
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — webhook signing secret (verifies incoming webhook payloads)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect — platform client ID (optional, for Stripe Connect onboarding)
STRIPE_CONNECT_CLIENT_ID=ca_...

# Resend — API key for transactional email
RESEND_API_KEY=re_...

# Email — sender address for outgoing mail (e.g. notifications@yourdomain.com)
# Falls back to onboarding@resend.dev (dev sandbox only) when empty.
EMAIL_FROM_ADDRESS=

# AI — any OpenAI-compatible chat-completions endpoint for the summary feature
# Leave all three blank to disable AI summaries (the endpoint returns 503).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
